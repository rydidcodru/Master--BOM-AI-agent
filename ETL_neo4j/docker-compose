services:
  neo4j:
    image: neo4j:5.26
    container_name: neo4j-graphrag
    restart: unless-stopped
    ports:
      - "7474:7474"   # HTTP / Neo4j Browser
      - "7687:7687"   # Bolt
    environment:
      NEO4J_AUTH: neo4j/0000
      NEO4J_dbms_security_auth__minimum__password__length: "1"
      NEO4J_PLUGINS: '["apoc"]'
      NEO4J_apoc_export_file_enabled: "true"
      NEO4J_apoc_import_file_enabled: "true"
      NEO4J_db_import_csv_legacy__quote__escaping: "false"
      NEO4J_dbms_security_procedures_unrestricted: "apoc.*"
      NEO4J_server_memory_heap_initial__size: "2G"
      NEO4J_server_memory_heap_max__size: "4G"
      NEO4J_server_memory_pagecache_size: "2G"
    volumes:
      - ${HOME}/neo4j/data:/data
      - ${HOME}/neo4j/logs:/logs
      - ${HOME}/neo4j/import:/var/lib/neo4j/import
      - ${HOME}/neo4j/plugins:/plugins
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://10.100.54.171:7474 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
