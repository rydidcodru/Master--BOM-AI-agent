# PostgreSQL + pgvector — single store for the MVP
POSTGRES_USER=lg
POSTGRES_PASSWORD=lg_password
POSTGRES_DB=lg_bom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM provider gate — local Ollama by default; "anthropic" to opt into Claude.
LLM_PROVIDER=ollama

# Ollama — local LLM serving (default provider)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:32b
EMBED_MODEL=bge-m3

# Anthropic Claude (opt-in provider; only used when LLM_PROVIDER=anthropic).
# SECURITY: never commit a real key. .env is gitignored — put your (rotated) key here only.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local embedding fallback (sentence-transformers); 1 = allow runtime embedding
ENABLE_EMBEDDING=0
EMBED_ST_MODEL=BAAI/bge-m3

# ── 변경점 어휘 v3 + 구조 스코프 검색 부스트 + 매핑 (2026-06-12) ──
DERIVE_CP=1                  # L1 변경점 유도(결정론 1차는 무해하므로 기본 on)
SEARCH_INCLUDE_STRUCT=0      # ①.5 구조 부스트 (평가 전 기본 off)
STRUCT_WEIGHT=1.0            # 레벨 B 융합에서 structure 랭킹 가중
MATCH_TAU_HI=0.75
MATCH_TAU_LO=0.45
MATCH_EPS=0.08
MATCH_THETA_COHERENCE=0.50
MATCH_TYPE_SCORE=0.20

# ── v2 패치 (P5~P8, 2026-06-12) ──
CASCADE_INFO=1        # P5 과거 동반변경 정보행 출력 (STRUCT 게이트 안에서만 유효)
DERIVE_CP_LLM=0       # P6 derive LLM 2차 분리 게이트 — 기본 off, 결정론만
RESCUE_SEARCH=0       # P7 저신뢰 시 1회 구제 재검색 — 평가 전 기본 off
SEARCH_LOW_CONF=0.30  # P7 "후보 약함" 판정용 dense 최고 유사도 하한
FEEDBACK_LOG=1        # P8 확정 피드백 기록(confirm_feedback)
