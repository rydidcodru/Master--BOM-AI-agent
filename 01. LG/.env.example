# ============================================================================
# Azure OpenAI (이미 사용 중인 키 — build_rag.py / rag_client.py 참조)
# ============================================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_TEXT_EMBEDDING_3_SMALL=text-embedding-3-small
AZURE_DEPLOYMENT_GPT_4O_MINI=gpt-4o-mini

# ============================================================================
# Chroma (legacy retrieval - GRAPH_RAG_ENABLED=0 일 때 폴백)
# ============================================================================
HARA_CHROMA_DIR=./chroma_db

# ============================================================================
# Graph RAG (LlamaIndex KG + Neo4j)
# ============================================================================
# Docker Compose(docker/docker-compose.neo4j.yml)로 기동한 로컬 Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lgbom-poc-2026
NEO4J_DB=neo4j

# 1=Graph RAG 사용(기본), 0=legacy Chroma 검색으로 폴백
GRAPH_RAG_ENABLED=1

# LLM 추출 캐시 디렉토리 (RSN 자유 텍스트 → ChangeReason JSON 결과 캐시)
GRAPH_RAG_LLM_CACHE_DIR=./data/cache

# ============================================================================
# LLM Provider 선택 (azure / ollama)
# - azure  : AZURE_DEPLOYMENT_GPT_4O_MINI 사용 (기본)
# - ollama : 로컬 Ollama 사용
# ============================================================================
LLM_PROVIDER=azure
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT=120

# ============================================================================
# Embedding Provider 선택 (azure / ollama)
# - azure  : AZURE_DEPLOYMENT_TEXT_EMBEDDING_3_SMALL 사용 (1536차원, 기본)
# - ollama : 로컬 Ollama 임베딩 모델 사용
#
# ⚠ Provider 또는 모델/차원을 바꾸면 Neo4j vector index 재생성 + 그래프 재빌드 필요:
#     python scripts/build_graph_rag.py --reset --reset-vector
# legacy Chroma(build_rag.py / rag_client.py)는 항상 Azure 임베딩 사용 (영향 없음).
# ============================================================================
EMBED_PROVIDER=azure
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024
